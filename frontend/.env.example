# Caminho da API, visto pelo navegador.
# Fica em /api de proposito: o front sempre chama a propria origem e quem
# repassa pra API de verdade e' o proxy (Vite em dev, rewrite do
# vercel.json em producao). Isso contorna a falta de CORS na API e o
# bloqueio de mixed content quando o site roda em HTTPS.
VITE_API_URL=/api

# Quando "true", o app usa a camada de mocks em src/services/mock e nao
# faz nenhuma chamada de rede. Util para navegar em todas as telas sem
# backend. Se VITE_API_URL nao estiver definida, os mocks ligam sozinhos.
VITE_USE_MOCKS=false

# Para onde o proxy do Vite aponta em desenvolvimento.
# SEM prefixo VITE_ de proposito: essa variavel e' lida pelo vite.config.ts
# (que roda no Node) e NAO entra no bundle. Em producao o destino esta'
# fixo no vercel.json, porque rewrite da Vercel nao interpola variavel.
API_PROXY_TARGET=http://147.15.112.97:8080
