# URL base da API do Gossip da Cupula.
# Tudo com prefixo VITE_ e' embutido no bundle e fica PUBLICO.
# Nunca coloque segredo (chave de API, connection string, JWT) aqui.
VITE_API_URL=http://localhost:5195/api

# Quando "true", o app usa a camada de mocks em src/services/mock e nao
# faz nenhuma chamada de rede. Util para navegar em todas as telas sem backend.
# Se VITE_API_URL nao estiver definida, os mocks ligam sozinhos.
VITE_USE_MOCKS=true
