# Sem nenhuma dessas variaveis, o app ja' fala com a API de verdade.
# Copie este arquivo para .env so' se precisar mudar algo.

# ---------------------------------------------------------------- API

# Caminho da API, visto pelo navegador. Padrao: /api
# Fica em /api de proposito: o front sempre chama a propria origem e quem
# repassa pra API de verdade e' o proxy (Vite em dev, funcao da Vercel em
# producao). Isso contorna a falta de CORS na API e o bloqueio de mixed
# content quando o site roda em HTTPS.
VITE_API_URL=/api

# Para onde o proxy aponta.
# SEM prefixo VITE_ de proposito: e' lida pelo vite.config.ts e pela funcao
# da Vercel (ambos no Node) e NAO entra no bundle.
API_PROXY_TARGET=http://147.15.112.97:8080

# -------------------------------------------------------------- Mocks

# Opt-in explicito. Com "true", o app nao faz nenhuma chamada de rede e
# serve dados de mentira — util pra navegar em todas as telas sem backend.
# Qualquer outro valor (ou ausencia) = API de verdade.
#
# Nao e' um interruptor geral: comentarios, fotos e links ficam mockados
# de qualquer jeito, porque a API ainda nao tem essas rotas.
VITE_USE_MOCKS=false
