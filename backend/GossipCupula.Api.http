@GossipCupula.Api_HostAddress = http://localhost:5195
@token = COLE_O_TOKEN_JWT_AQUI
@postId = 00000000-0000-0000-0000-000000000000

POST {{GossipCupula.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "username": "dan.humphrey",
  "email": "dan.humphrey@example.com",
  "password": "senhaSegura123"
}

###

POST {{GossipCupula.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "dan.humphrey@example.com",
  "password": "senhaSegura123"
}

###

# Comentários são 100% anônimos: o corpo leva só o texto (nada de autor).
POST {{GossipCupula.Api_HostAddress}}/api/posts/{{postId}}/comments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "text": "soltei o babado primeiro"
}

###

GET {{GossipCupula.Api_HostAddress}}/api/posts/{{postId}}/comments?limit=20
Authorization: Bearer {{token}}

###

# Página seguinte: o cursor é o nextCursor devolvido na resposta anterior.
GET {{GossipCupula.Api_HostAddress}}/api/posts/{{postId}}/comments?limit=20&cursor=COLE_O_NEXTCURSOR_AQUI
Authorization: Bearer {{token}}

###

# Contador isolado de comentários: { "count": N }
GET {{GossipCupula.Api_HostAddress}}/api/posts/{{postId}}/comments/count
Authorization: Bearer {{token}}

###

# Publica com imagem (multipart/form-data). O arquivo precisa existir no disco.
POST {{GossipCupula.Api_HostAddress}}/api/posts
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=----GossipBoundary

------GossipBoundary
Content-Disposition: form-data; name="text"

o babado agora tem foto
------GossipBoundary
Content-Disposition: form-data; name="images"; filename="babado.png"
Content-Type: image/png

< ./babado.png
------GossipBoundary--

###

# Publica sem imagem, no contrato JSON antigo (rota separada da multipart).
POST {{GossipCupula.Api_HostAddress}}/api/posts/json
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "sem foto",
  "content": "só o texto, como antes"
}

###
